config server
	# Loopback only, always. The daemon refuses to start on a routable address.
	# HTTP transport, reached from a workstation with:
	#   ssh -N -L 8730:127.0.0.1:8730 root@router
	option listen '127.0.0.1:8730'
	# Root-only unix socket for the stdio transport (`openwrt-mcp stdio`, run by an SSH
	# forced command -- see `openwrt-mcp authorize-key`). Set to '' to disable.
	option socket '/var/run/openwrt-mcp/mcp.sock'
	option audit '/etc/openwrt-mcp/audit.jsonl'
	option audit_max_mb '16'
	# Second-factor limiter. This many wrong codes in a row lock a client out of mfa_unlock
	# for mfa_lockout seconds (or '5m'), doubling on each repeat up to one hour. The state is
	# in memory, so a restart clears it. Defaults shown.
	# option mfa_max_failures '5'
	# option mfa_lockout '300'
	# Tool output hides the value of secret options (key, psk, password, private_key, token, ...)
	# in uci_get, uci_apply, pkg_config_diff, system_status and ubus_call. Only a literal '0'
	# turns it off, and doing so leaves an audit entry. redact_extra adds your own option names.
	# option redact_output '1'
	# list redact_extra 'vendor_blob'
	# After a change is confirmed, the config as it was before is kept (uci_get history=list,
	# uci_apply restore=<id>). This many versions per config; 0 turns history off, at most 20.
	# The entries hold secrets like /etc/config does and are part of a sysupgrade backup.
	# option history_keep '5'
	# Optional channels, switched on from LuCI (Services -> MCP Server -> Settings). Each is off
	# until you turn it on, and each switch is audited. 'pairing' adds a Clients tab where a
	# public key can be bound to the MCP bridge from the browser.
	# option pairing '0'
	# 'push_hook' sends each new approval request as the ubus event openwrt-mcp.request and to every
	# executable in /etc/openwrt-mcp/hooks.d/ (JSON on stdin), e.g. to ping your phone.
	# option push_hook '0'
	# 'chat_approve' also asks the calling MCP client to approve a held call in its own prompt (exact
	# scope, at most 8h, never a root-shell tool). Name the clients that may use it, or leave the list
	# empty for every client that supports elicitation.
	# option chat_approve '0'
	# list chat_approve_client 'claude-code'

# No policies by default: every gated tool is denied until you grant it.
# ubus_list and mfa_unlock are the exceptions -- introspection and the second factor itself.
#
# Grant with a preset:
#   openwrt-mcp allow claude-code @readonly 30d
#   openwrt-mcp allow claude-code @operator 7d
# or tool by tool:
#   openwrt-mcp allow claude-code uci_apply 'dhcp.* wireless.*.disabled' 30d
#
# config policy
#	option client       'claude-code'
#	list   tools        'uci_apply'
#	list   tools        'uci_confirm'
#	list   scopes       'dhcp.*'
#	option max_per_min  '60'
#	option expires      '2026-12-31'
#	option enabled      '1'
#	list   mfa_tools    'uci_apply'
#	option mfa_window   '15m'

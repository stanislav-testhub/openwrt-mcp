#!/bin/sh /etc/rc.common

USE_PROCD=1
# After network (20) and firewall (19): at boot, an apply left unconfirmed before a reboot
# is rolled back as soon as the daemon starts, and the reload it triggers needs netifd up.
START=95
STOP=10

PROG=/usr/bin/openwrt-mcp

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" serve
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	# Policies, tokens and MFA secrets are re-read from disk on change, so a reload is
	# only needed to pick up a changed listen address or socket.
	restart
}
